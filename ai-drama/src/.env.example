APP_NAME="AI 短剧一站式服务平台"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai
APP_URL=http://localhost:8080

# 前端
FRONTEND_URL=http://localhost:8080
VITE_HOST=node
VITE_PORT=5173

# 数据库
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ai_drama
DB_USERNAME=root
DB_PASSWORD=secret

# Redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_HORIZON_DB=3
REDIS_REVERB_DB=4

# 队列
QUEUE_CONNECTION=redis
HORIZON_PREFIX=aidrama:
HORIZON_TERMINATE_TIMEOUT=60

# 会话
SESSION_DRIVER=redis
SESSION_CONNECTION=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080,127.0.0.1,127.0.0.1:8080
SESSION_DOMAIN=localhost

# 文件存储
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true

# 短信（阿里云）
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=AI短剧
SMS_TEMPLATE_CODE=SMS_000000000

# 邮件
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Reverb WebSocket
REVERB_APP_ID=aidrama
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http

# 内部签名（Laravel ↔ Python 通信）
INTERNAL_SIGN_KEY=

# 加密（AES-256）
CIPHER_KEY=

# 微信支付
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_KEY=
WECHAT_PAY_CERT_PATH=
WECHAT_PAY_CERT_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=http://localhost:8080/api/payments/callback/wechat

# 支付宝
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=http://localhost:8080/api/payments/callback/alipay

# Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
