{
    "name": "aidrama/platform",
    "description": "AI 短剧一站式服务平台 — Laravel 12 全栈",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/horizon": "^5.24",
        "laravel/reverb": "^1.4",
        "laravel/pint": "^1.18",
        "inertiajs/inertia-laravel": "^1.3",
        "spatie/laravel-permission": "^6.9",
        "owen-it/laravel-auditing": "^14.0",
        "yansongda/pay": "^3.7",
        "overtrue/laravel-wechat": "^6.0",
        "stripe/stripe-php": "^16.0",
        "predis/predis": "^2.0",
        "php-ffmpeg/php-ffmpeg": "^1.0",
        "guzzlehttp/guzzle": "^7.9",
        "league/flysystem-aws-s3-v3": "^3.0",
        "league/flysystem-async-aws-s3": "^3.0",
        "maennchen/zipstream-php": "^3.1",
        "doctrine/dbal": "^3.8",
        "spatie/laravel-data": "^4.13",
        "darkaonline/l5-swagger": "^9.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.36",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^3.5",
        "pestphp/pest-plugin-laravel": "^3.0",
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi",
            "@php -r \"file_exists('package.json') || file_put_contents('package.json', '');\"",
            "@php artisan ui:auth"
        ],
        "migrate": [
            "@php artisan migrate"
        ],
        "test": [
            "@php artisan test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "scripts-descriptions": {
        "test": "运行测试套件"
    }
}
